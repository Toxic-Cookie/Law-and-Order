<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Ritual Outcome Effect Definition for Hearing -->
  <RitualOutcomeEffectDef>
    <defName>LawAndOrder_HearingOutcome</defName>
    <description>A formal legal hearing has been conducted.</description>
    <workerClass>Law_and_Order.Source.Rituals.RitualOutcomeEffectWorker_Hearing</workerClass>

    <!-- Basic quality settings (not used heavily in our implementation) -->
    <startingQuality>1.0</startingQuality>
    <minQuality>0.0</minQuality>
    <maxQuality>1.0</maxQuality>

    <!-- Don't give development points for hearings -->
    <givesDevelopmentPoints>false</givesDevelopmentPoints>

    <!-- Don't warn on low quality -->
    <warnOnLowQuality>false</warnOnLowQuality>

    <!-- Don't allow attachable outcomes -->
    <allowAttachableOutcome>false</allowAttachableOutcome>

    <!-- Empty comps list (required to prevent null reference) -->
    <comps />

    <!-- Simple outcome: hearings are always "completed" -->
    <outcomeChances>
      <li>
        <label>completed</label>
        <description>The hearing has been completed. {PAWN_nameDef} has been tried for {PAWN_possessive} crimes.</description>
        <positivityIndex>0</positivityIndex>
        <chance>1.0</chance>
        <!-- No memory thought here - those are handled by the plea bargain system -->
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

</Defs>
