<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Court Hearing Ritual Precept -->
  <PreceptDef>
    <defName>LawAndOrder_CourtHearing</defName>
    <label>court hearing</label>
    <description>A formal court hearing where a prisoner is tried for their crimes before a judge. The outcome depends on the quality of the proceedings and can result in different plea bargain outcomes.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <iconPath>UI/Icons/Rituals/RitualFestival</iconPath>
    <preceptClass>Precept_Ritual</preceptClass>
    <ritualPatternBase>LawAndOrder_CourtHearingPattern</ritualPatternBase>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
    <ignoreLimitsInEditMode>true</ignoreLimitsInEditMode>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
  </PreceptDef>

  <!-- Ritual Pattern -->
  <RitualPatternDef>
    <defName>LawAndOrder_CourtHearingPattern</defName>
    <ritualFreeStartIntervalDaysRange>0.1</ritualFreeStartIntervalDaysRange>
    <ritualBehavior>LawAndOrder_CourtHearingBehavior</ritualBehavior>
    <shortDescOverride>court hearing</shortDescOverride>
    <descOverride>A prisoner is escorted to court, tried before a judge, and sentenced based on the quality of the proceedings.</descOverride>
    <ritualOutcomeEffect>LawAndOrder_CourtHearingOutcome</ritualOutcomeEffect>
    <nameMaker>NamerRitualFestival</nameMaker>
    <iconPathOverride>UI/Icons/Rituals/RitualFestival</iconPathOverride>
    <canStartAnytime>true</canStartAnytime>
    <ritualObligationTargetFilter>GatheringSpotOrAltar</ritualObligationTargetFilter>
    <tags>
      <li>LawAndOrder_CourtHearing</li>
    </tags>
    <patternGroupTag>LawAndOrder_CourtHearing</patternGroupTag>
  </RitualPatternDef>

  <!-- Ritual Behavior -->
  <RitualBehaviorDef>
    <defName>LawAndOrder_CourtHearingBehavior</defName>
    <workerClass>Law_and_Order.Source.Rituals.RitualBehaviorWorker_CourtHearing</workerClass>
    <durationTicks>
      <min>2500</min>
      <max>3500</max>
    </durationTicks>
    <spectatorsLabel>Observers</spectatorsLabel>
    <spectatorGerund>observe</spectatorGerund>

    <roles>
      <!-- Judge Role -->
      <li Class="RimWorld.RitualRoleWarden">
        <id>judge</id>
        <label>judge</label>
        <categoryLabel>judge</categoryLabel>
        <required>true</required>
        <substitutable>false</substitutable>
        <maxCount>1</maxCount>
        <countsAsParticipant>true</countsAsParticipant>
        <allowChild>false</allowChild>
        <mustBeAbleToReachTarget>true</mustBeAbleToReachTarget>
        <missingDesc>a judge</missingDesc>
        <noCandidatesGizmoDesc>No colonist available to serve as judge.</noCandidatesGizmoDesc>
      </li>

      <!-- Defendant Role (Prisoner) - Use CRF's prisoner role -->
      <li Class="TPRitualAttachableOutcomes.RitualRolePrisonerOrSlave_NonDuel">
        <id>defendant</id>
        <label>defendant</label>
        <categoryLabel>defendant</categoryLabel>
        <required>true</required>
        <substitutable>false</substitutable>
        <maxCount>1</maxCount>
        <countsAsParticipant>false</countsAsParticipant>
        <missingDesc>a prisoner defendant</missingDesc>
        <noCandidatesGizmoDesc>No prisoner available to be tried.</noCandidatesGizmoDesc>
      </li>

      <!-- Victim Role (Optional) -->
      <li Class="Law_and_Order.Source.Rituals.RitualRole_Victim">
        <id>victim</id>
        <label>victim</label>
        <categoryLabel>victim</categoryLabel>
        <required>false</required>
        <substitutable>true</substitutable>
        <maxCount>3</maxCount>
        <countsAsParticipant>true</countsAsParticipant>
        <missingDesc>crime victims</missingDesc>
      </li>

      <!-- Jury Role (Optional) -->
      <li Class="Law_and_Order.Source.Rituals.RitualRole_Jury">
        <id>jury</id>
        <label>juror</label>
        <categoryLabel>jury</categoryLabel>
        <required>false</required>
        <substitutable>true</substitutable>
        <maxCount>12</maxCount>
        <countsAsParticipant>true</countsAsParticipant>
        <missingDesc>jurors</missingDesc>
      </li>
    </roles>

    <stages>
      <!-- Stage 0: Escorting Defendant to Court -->
      <li Class="RitualStage_InteractWithRole">
        <defaultDuty>Spectate</defaultDuty>
        <targetId>defendant</targetId>
        <endTriggers>
          <li Class="StageEndTrigger_PawnDeliveredOrNotValid"/>
        </endTriggers>
        <failTriggers>
          <li Class="StageFailTrigger_TargetPawnUnreachable">
            <takerId>judge</takerId>
            <takeeId>defendant</takeeId>
            <desc>Defendant is not reachable.</desc>
          </li>
        </failTriggers>
        <roleBehaviors>
          <li>
            <roleId>judge</roleId>
            <dutyDef>DeliverPawnToAltar</dutyDef>
          </li>
          <li>
            <roleId>defendant</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
        </roleBehaviors>
      </li>

      <!-- Stage 1: The Hearing - single stage that runs to completion -->
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1.0</percentage>
          </li>
        </endTriggers>
      </li>
    </stages>
  </RitualBehaviorDef>

  <!-- Ritual Outcome Effects -->
  <RitualOutcomeEffectDef>
    <defName>LawAndOrder_CourtHearingOutcome</defName>
    <description>Depending on ritual quality and the defendant's plea, different sentencing outcomes will occur.</description>

    <!-- Use CRF custom outcome worker -->
    <workerClass>TPRitualAttachableOutcomes.RitualOutcomeEffectWorker_FromQuality_TP_Custom</workerClass>

    <allowAttachableOutcome>false</allowAttachableOutcome>

    <!-- Quality factors -->
    <comps>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(1, 0.0)</li>
            <li>(3, 0.15)</li>
            <li>(5, 0.25)</li>
            <li>(8, 0.35)</li>
          </points>
        </curve>
      </li>
    </comps>

    <!-- Outcome chances map to hearing quality results -->
    <outcomeChances>
      <!-- Poor Quality (Incompetent hearing) -->
      <li>
        <label>Poor Quality</label>
        <chance>0.10</chance>
        <memory>LawAndOrder_CourtHearingNoDeal</memory>
        <description>The hearing was a mess. The judge seemed confused and went very easy on the sentence.</description>
        <positivityIndex>-2</positivityIndex>
      </li>

      <!-- Partial Quality (Sloppy hearing) -->
      <li>
        <label>Partial Quality</label>
        <chance>0.25</chance>
        <memory>LawAndOrder_CourtHearingPartialDeal</memory>
        <description>The hearing was somewhat disorganized. The judge handed down a lenient sentence.</description>
        <positivityIndex>-1</positivityIndex>
      </li>

      <!-- Standard Quality (Fair hearing) -->
      <li>
        <label>Standard Quality</label>
        <chance>0.50</chance>
        <memory>LawAndOrder_CourtHearingStandardPlea</memory>
        <description>The hearing proceeded fairly. The judge handed down a standard, just sentence.</description>
        <positivityIndex>1</positivityIndex>
      </li>

      <!-- Excellent Quality (Professional hearing) -->
      <li>
        <label>Excellent Quality</label>
        <chance>0.15</chance>
        <memory>LawAndOrder_CourtHearingExcellentPlea</memory>
        <description>The hearing was conducted with professionalism. The judge imposed a full, proper sentence.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>

    <!-- Custom effects using CRF modExtensions -->
    <modExtensions>
      <!-- Poor Quality: Lenient sentence, high demoralization -->
      <li Class="TPRitualAttachableOutcomes.RitualAttachableOutcomeEffectDef_TP_Custom">
        <triggerPositivityIndex>
          <li>-2</li>
        </triggerPositivityIndex>
        <node>
          <li>
            <appliesTo>
              <li>defendant</li>
            </appliesTo>
            <suppression>0.20</suppression>
            <willReduction>1.0</willReduction>
          </li>
        </node>
      </li>

      <!-- Partial Quality: Moderate effects -->
      <li Class="TPRitualAttachableOutcomes.RitualAttachableOutcomeEffectDef_TP_Custom">
        <triggerPositivityIndex>
          <li>-1</li>
        </triggerPositivityIndex>
        <node>
          <li>
            <appliesTo>
              <li>defendant</li>
            </appliesTo>
            <suppression>0.10</suppression>
            <willReduction>0.5</willReduction>
          </li>
        </node>
      </li>

      <!-- Standard Quality: Light effects -->
      <li Class="TPRitualAttachableOutcomes.RitualAttachableOutcomeEffectDef_TP_Custom">
        <triggerPositivityIndex>
          <li>1</li>
        </triggerPositivityIndex>
        <node>
          <li>
            <appliesTo>
              <li>defendant</li>
            </appliesTo>
            <suppression>0.05</suppression>
          </li>
        </node>
      </li>

      <!-- Excellent Quality: Minimal suppression, high motivation -->
      <li Class="TPRitualAttachableOutcomes.RitualAttachableOutcomeEffectDef_TP_Custom">
        <triggerPositivityIndex>
          <li>2</li>
        </triggerPositivityIndex>
        <node>
          <li>
            <appliesTo>
              <li>defendant</li>
            </appliesTo>
            <suppression>0.02</suppression>
          </li>
        </node>
      </li>
    </modExtensions>
  </RitualOutcomeEffectDef>

  <!-- Thought Defs for each outcome -->
  <ThoughtDef>
    <defName>LawAndOrder_CourtHearingNoDeal</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>incompetent court hearing</label>
        <description>The hearing was a mess. The judge seemed confused but went easy on the sentence.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>LawAndOrder_CourtHearingPartialDeal</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>sloppy court hearing</label>
        <description>The hearing was somewhat disorganized. Justice was served, but not impressively.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>LawAndOrder_CourtHearingStandardPlea</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>fair court hearing</label>
        <description>The hearing was conducted fairly. Justice was properly served.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>LawAndOrder_CourtHearingExcellentPlea</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>professional court hearing</label>
        <description>The hearing was conducted with professionalism. True justice was served.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
