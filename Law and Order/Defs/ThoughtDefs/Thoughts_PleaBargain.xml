<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Impressed by prisoner's plea (adjudicator receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_ImpressedByPlea</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>impressed by plea</label>
        <description>That prisoner made a very compelling case. I'm genuinely impressed by their eloquence.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Incompetent hearing - very lenient sentence (prisoner receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_HumiliatedInCourt</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>incompetent court hearing</label>
        <description>The hearing was a mess. The judge seemed confused and went easy on me. I'll take it, but this wasn't real justice.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Fair hearing - standard sentence (prisoner receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_PleaAccepted</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>fair court hearing</label>
        <description>The hearing was conducted properly. I received a fair sentence for my crimes. I can accept that.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Professional hearing - harsh sentence but motivated (prisoner receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_PleaImpressive</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>professional court hearing</label>
        <description>The hearing was conducted with professionalism. The sentence is harsh but fair. At least I can work it off efficiently.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Sloppy hearing - lenient sentence but slow repayment (prisoner receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_PleaRejected</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>sloppy court hearing</label>
        <description>The hearing was poorly conducted. The judge went easy on my sentence, but I feel demoralized by the whole process.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Presided over a hearing (judge receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_PresidedOverHearing</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.75</stackedEffectMultiplier>
    <stages>
      <li>
        <label>presided over hearing</label>
        <description>I served justice by presiding over a court hearing. It feels good to uphold the law.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Attended a hearing (spectator receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_AttendedHearing</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>2</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages>
      <li>
        <label>attended hearing</label>
        <description>I witnessed justice being served in court. The legal process is reassuring.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Confronted criminal in court (victim receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_ConfrontedCriminal</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>confronted criminal</label>
        <description>I got to speak out against the one who wronged me. It feels good to have my voice heard.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Confronted by victim in court (defendant receives this) -->
  <ThoughtDef>
    <defName>LawAndOrder_ConfrontedByVictim</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>confronted by victim</label>
        <description>I had to face my victim in court. Their words were difficult to hear.</description>
        <baseMoodEffect>-4</baseMoodEffect>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
