<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Administer Beating Job -->
  <JobDef>
    <defName>LawAndOrder_AdministerBeating</defName>
    <driverClass>Law_and_Order.Source.Jobs.JobDriver_AdministerBeating</driverClass>
    <reportString>administering beating to TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <collideWithPawns>false</collideWithPawns>
    <playerInterruptible>true</playerInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

  <!-- Execute Prisoner Job (uses vanilla execution but with our tracking) -->
  <JobDef>
    <defName>LawAndOrder_ExecutePrisoner</defName>
    <driverClass>Law_and_Order.Source.Jobs.JobDriver_ExecutePrisoner</driverClass>
    <reportString>executing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <collideWithPawns>false</collideWithPawns>
    <playerInterruptible>true</playerInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

</Defs>
