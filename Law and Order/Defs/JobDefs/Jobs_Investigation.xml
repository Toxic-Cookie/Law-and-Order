<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Job for wardens to investigate cases by interrogating prisoners -->
    <JobDef>
        <defName>LawAndOrder_InvestigateCase</defName>
        <driverClass>Law_and_Order.Source.Investigation.JobDriver_InvestigateCase</driverClass>
        <reportString>interrogating TargetA at TargetB.</reportString>
        <casualInterruptible>false</casualInterruptible>
        <collideWithPawns>true</collideWithPawns>
        <suspendable>false</suspendable>
        <alwaysShowWeapon>false</alwaysShowWeapon>
        <neverShowWeapon>true</neverShowWeapon>
        <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
        <carryThingAfterJob>true</carryThingAfterJob>
    </JobDef>

    <!-- WorkGiver for wardens to automatically interrogate prisoners -->
    <WorkGiverDef>
        <defName>LawAndOrder_InvestigateCase_Warden</defName>
        <label>investigate criminal cases</label>
        <giverClass>Law_and_Order.Source.Investigation.WorkGiver_Warden_InvestigateCase</giverClass>
        <workType>Warden</workType>
        <verb>Interrogate</verb>
        <gerund>interrogating</gerund>
        <priorityInType>30</priorityInType>
        <requiredCapacities>
            <li>Talking</li>
            <li>Hearing</li>
            <li>Moving</li>
        </requiredCapacities>
    </WorkGiverDef>

    <!-- Job for analyzing crime scene clues -->
    <JobDef>
        <defName>AnalyzeCrimeClue</defName>
        <driverClass>Law_and_Order.Source.Investigation.JobDriver_AnalyzeClue</driverClass>
        <reportString>analyzing TargetA.</reportString>
        <casualInterruptible>true</casualInterruptible>
        <collideWithPawns>false</collideWithPawns>
        <suspendable>true</suspendable>
        <alwaysShowWeapon>false</alwaysShowWeapon>
        <neverShowWeapon>true</neverShowWeapon>
        <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
        <joySkill>Intellectual</joySkill>
        <joyXpPerTick>0.02</joyXpPerTick>
    </JobDef>

    <!-- WorkGiver for researchers to analyze clues -->
    <WorkGiverDef>
        <defName>AnalyzeCrimeClue_Research</defName>
        <label>analyze crime clues</label>
        <giverClass>Law_and_Order.Source.Investigation.WorkGiver_AnalyzeClue</giverClass>
        <workType>Research</workType>
        <verb>Analyze</verb>
        <gerund>analyzing clue</gerund>
        <priorityInType>90</priorityInType>
        <requiredCapacities>
            <li>Manipulation</li>
            <li>Moving</li>
            <li>Sight</li>
        </requiredCapacities>
    </WorkGiverDef>

    <!-- WorkGiver for wardens to also analyze clues -->
    <WorkGiverDef>
        <defName>AnalyzeCrimeClue_Warden</defName>
        <label>analyze crime clues</label>
        <giverClass>Law_and_Order.Source.Investigation.WorkGiver_AnalyzeClue</giverClass>
        <workType>Warden</workType>
        <verb>Analyze</verb>
        <gerund>analyzing clue</gerund>
        <priorityInType>25</priorityInType>
        <requiredCapacities>
            <li>Manipulation</li>
            <li>Moving</li>
            <li>Sight</li>
        </requiredCapacities>
    </WorkGiverDef>

    <!-- Job for manually cleaning up fully analyzed clues (via right-click) -->
    <JobDef>
        <defName>LawAndOrder_CleanupClue</defName>
        <driverClass>Law_and_Order.Source.Investigation.JobDriver_CleanupClue</driverClass>
        <reportString>cleaning up TargetA.</reportString>
        <casualInterruptible>true</casualInterruptible>
        <collideWithPawns>false</collideWithPawns>
        <suspendable>true</suspendable>
        <alwaysShowWeapon>false</alwaysShowWeapon>
        <neverShowWeapon>true</neverShowWeapon>
        <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    </JobDef>
</Defs>
