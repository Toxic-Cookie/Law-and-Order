<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Judge sentences the defendant -->
  <InteractionDef>
    <defName>LawAndOrder_JudgeSentences</defName>
    <label>sentence defendant</label>
    <symbol>UI/Icons/Rituals/CourtHearing</symbol>
    <ignoreTimeSinceLastInteraction>true</ignoreTimeSinceLastInteraction>
    <socialFightBaseChance>0</socialFightBaseChance>

    <!-- Judge gets XP for social skill -->
    <initiatorXpGainSkill>Social</initiatorXpGainSkill>
    <initiatorXpGainAmount>20</initiatorXpGainAmount>

    <!-- Log rules for initiator (judge's perspective) -->
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameIndef] pronounced judgment on [RECIPIENT_nameIndef].</li>
        <li>r_logentry->[INITIATOR_nameIndef] sentenced [RECIPIENT_nameIndef] for their crimes.</li>
        <li>r_logentry->[INITIATOR_nameIndef] delivered the court's verdict to [RECIPIENT_nameIndef].</li>
      </rulesStrings>
    </logRulesInitiator>

    <!-- Log rules for recipient (defendant's perspective) -->
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameIndef] judged [RECIPIENT_nameIndef] in court.</li>
        <li>r_logentry->[RECIPIENT_nameIndef] was sentenced by [INITIATOR_nameIndef].</li>
        <li>r_logentry->[RECIPIENT_nameIndef] received judgment from [INITIATOR_nameIndef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <!-- Defendant pleads to the judge -->
  <InteractionDef>
    <defName>LawAndOrder_DefendantPleads</defName>
    <label>plead to judge</label>
    <symbol>UI/Icons/Rituals/CourtHearing</symbol>
    <ignoreTimeSinceLastInteraction>true</ignoreTimeSinceLastInteraction>
    <socialFightBaseChance>0</socialFightBaseChance>

    <!-- Defendant gets XP for social skill -->
    <initiatorXpGainSkill>Social</initiatorXpGainSkill>
    <initiatorXpGainAmount>15</initiatorXpGainAmount>

    <!-- Log rules for initiator (defendant's perspective) -->
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameIndef] pleaded their case to [RECIPIENT_nameIndef].</li>
        <li>r_logentry->[INITIATOR_nameIndef] made a plea for leniency before [RECIPIENT_nameIndef].</li>
        <li>r_logentry->[INITIATOR_nameIndef] argued for mercy in front of [RECIPIENT_nameIndef].</li>
      </rulesStrings>
    </logRulesInitiator>

    <!-- Log rules for recipient (judge's perspective) -->
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameIndef] heard [INITIATOR_nameIndef]'s plea.</li>
        <li>r_logentry->[INITIATOR_nameIndef] pleaded before [RECIPIENT_nameIndef].</li>
        <li>r_logentry->[RECIPIENT_nameIndef] listened to [INITIATOR_nameIndef]'s defense.</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <!-- Victim confronts defendant -->
  <InteractionDef>
    <defName>LawAndOrder_VictimConfronts</defName>
    <label>confront in court</label>
    <symbol>UI/Icons/Rituals/CourtHearing</symbol>
    <ignoreTimeSinceLastInteraction>true</ignoreTimeSinceLastInteraction>
    <socialFightBaseChance>0.02</socialFightBaseChance>

    <!-- Victim gets catharsis thought -->
    <initiatorThought>LawAndOrder_ConfrontedCriminal</initiatorThought>

    <!-- Defendant feels guilty or defensive -->
    <recipientThought>LawAndOrder_ConfrontedByVictim</recipientThought>

    <!-- Log rules for initiator (victim's perspective) -->
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameIndef] confronted [RECIPIENT_nameIndef] about their crimes.</li>
        <li>r_logentry->[INITIATOR_nameIndef] spoke out against [RECIPIENT_nameIndef] in court.</li>
        <li>r_logentry->[INITIATOR_nameIndef] testified against [RECIPIENT_nameIndef].</li>
        <li>r_logentry->[INITIATOR_nameIndef] accused [RECIPIENT_nameIndef] before the court.</li>
      </rulesStrings>
    </logRulesInitiator>

    <!-- Log rules for recipient (defendant's perspective) -->
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameIndef] was confronted by [INITIATOR_nameIndef] in court.</li>
        <li>r_logentry->[INITIATOR_nameIndef] accused [RECIPIENT_nameIndef] publicly.</li>
        <li>r_logentry->[RECIPIENT_nameIndef] faced [INITIATOR_nameIndef]'s testimony.</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <!-- Judge questions defendant -->
  <InteractionDef>
    <defName>LawAndOrder_JudgeQuestions</defName>
    <label>question defendant</label>
    <symbol>UI/Icons/Rituals/CourtHearing</symbol>
    <ignoreTimeSinceLastInteraction>true</ignoreTimeSinceLastInteraction>
    <socialFightBaseChance>0</socialFightBaseChance>

    <!-- Judge gets XP -->
    <initiatorXpGainSkill>Social</initiatorXpGainSkill>
    <initiatorXpGainAmount>10</initiatorXpGainAmount>

    <!-- Log rules for initiator (judge's perspective) -->
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameIndef] questioned [RECIPIENT_nameIndef] about the charges.</li>
        <li>r_logentry->[INITIATOR_nameIndef] examined [RECIPIENT_nameIndef]'s testimony.</li>
        <li>r_logentry->[INITIATOR_nameIndef] interrogated [RECIPIENT_nameIndef] in court.</li>
      </rulesStrings>
    </logRulesInitiator>

    <!-- Log rules for recipient (defendant's perspective) -->
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameIndef] was questioned by [INITIATOR_nameIndef].</li>
        <li>r_logentry->[INITIATOR_nameIndef] examined [RECIPIENT_nameIndef] under oath.</li>
        <li>r_logentry->[RECIPIENT_nameIndef] answered [INITIATOR_nameIndef]'s questions.</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

</Defs>
