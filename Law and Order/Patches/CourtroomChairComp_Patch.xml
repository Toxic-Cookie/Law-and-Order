<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Add CompCourtroomChair to all sittable furniture -->
  <!-- This allows any chair, stool, throne, etc. to be designated for courtroom use -->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Core</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- First, try to add to existing comps list -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[building/isSittable = "true"]/comps</xpath>
          <value>
            <li Class="Law_and_Order.Source.Rituals.CompProperties_CourtroomChair" />
          </value>
        </li>

        <!-- If comps doesn't exist, create it -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[building/isSittable = "true"][not(comps)]</xpath>
          <value>
            <comps>
              <li Class="Law_and_Order.Source.Rituals.CompProperties_CourtroomChair" />
            </comps>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
