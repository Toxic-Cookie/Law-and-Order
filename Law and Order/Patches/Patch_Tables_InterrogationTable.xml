<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!--
        Adds Comp_InterrogationTable to all tables, allowing them to be designated as interrogation tables.
        This follows the same pattern used for other building designations.
    -->

    <!-- Add to all dining/work tables (Building_WorkTable) -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Core</li>
        </mods>
        <match Class="PatchOperationSequence">
            <success>Always</success>
            <operations>
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>/Defs/ThingDef[thingClass="Building_WorkTable" or @ParentName="TableBase" or @ParentName="BenchBase"]/comps</xpath>
                    <value>
                        <li Class="Law_and_Order.Source.Investigation.CompProperties_InterrogationTable"/>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

    <!-- Also add to dining tables specifically (surfaceType Eat) -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Core</li>
        </mods>
        <match Class="PatchOperationSequence">
            <success>Always</success>
            <operations>
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>/Defs/ThingDef[surfaceType='Eat']/comps</xpath>
                    <value>
                        <li Class="Law_and_Order.Source.Investigation.CompProperties_InterrogationTable"/>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

    <!-- Add to vanilla specific tables by defName for better compatibility -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Core</li>
        </mods>
        <match Class="PatchOperationSequence">
            <success>Always</success>
            <operations>
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>/Defs/ThingDef[
                        defName="TableShort" or
                        defName="TableLong" or
                        defName="TableButcher" or
                        defName="TableStonecutter" or
                        defName="TableMachining" or
                        defName="SimpleResearchBench" or
                        defName="HiTechResearchBench" or
                        defName="ElectricSmithy" or
                        defName="FueledSmithy" or
                        defName="ElectricTailoringBench" or
                        defName="HandTailoringBench"
                    ]/comps</xpath>
                    <value>
                        <li Class="Law_and_Order.Source.Investigation.CompProperties_InterrogationTable"/>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
