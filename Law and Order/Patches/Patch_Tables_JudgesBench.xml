<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Add Comp_JudgesBench to all tables so they can be designated as Judge's Bench -->
  <Operation Class="PatchOperationSequence">
    <operations>

      <!-- Patch all dining tables that inherit from TableGatherSpotBase -->
      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/ThingDef[@ParentName="TableGatherSpotBase"]/comps</xpath>
        <value>
          <li Class="Law_and_Order.Source.Buildings.CompProperties_JudgesBench"/>
        </value>
      </li>

      <!-- Patch vanilla dining tables by defName (for those not using TableGatherSpotBase parent) -->
      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="TableShort" or defName="TableLong"]/comps</xpath>
        <value>
          <li Class="Law_and_Order.Source.Buildings.CompProperties_JudgesBench"/>
        </value>
      </li>

      <!-- Patch all production/work tables -->
      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="TableButcher" or defName="TableStonecutter" or defName="TableMachining" or defName="TableSmithing" or defName="TableTailor" or defName="TableCraftingStone"]/comps</xpath>
        <value>
          <li Class="Law_and_Order.Source.Buildings.CompProperties_JudgesBench"/>
        </value>
      </li>

      <!-- Patch research benches -->
      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/ThingDef[defName="SimpleResearchBench" or defName="HiTechResearchBench"]/comps</xpath>
        <value>
          <li Class="Law_and_Order.Source.Buildings.CompProperties_JudgesBench"/>
        </value>
      </li>

      <!-- Handle tables that don't have comps element yet - create comps for dining tables -->
      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/ThingDef[@ParentName="TableGatherSpotBase" and not(comps)]</xpath>
        <value>
          <comps>
            <li Class="Law_and_Order.Source.Buildings.CompProperties_JudgesBench"/>
          </comps>
        </value>
      </li>

      <!-- Handle tables that don't have comps element yet - create comps for work/research tables -->
      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>/Defs/ThingDef[(defName="TableShort" or defName="TableLong" or defName="TableButcher" or defName="TableStonecutter" or defName="TableMachining" or defName="TableSmithing" or defName="TableTailor" or defName="TableCraftingStone" or defName="SimpleResearchBench" or defName="HiTechResearchBench") and not(comps)]</xpath>
        <value>
          <comps>
            <li Class="Law_and_Order.Source.Buildings.CompProperties_JudgesBench"/>
          </comps>
        </value>
      </li>

    </operations>
  </Operation>

</Patch>
